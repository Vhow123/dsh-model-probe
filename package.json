{
  "name": "@local/dsh-model-probe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH model connectivity and latency probe",
  "license": "UNLICENSED",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js"
  },
  "files": ["index.js", "client.js", "locale", "icon.svg", "README.md"]
}
