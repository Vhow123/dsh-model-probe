{
  "name": "@local/dsh-model-probe",
  "version": "1.0.0",
  "type": "module",
  "description": "Test DSH model connectivity, first-response latency, total elapsed time and token usage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vhow123/dsh-model-probe.git"
  },
  "homepage": "https://github.com/Vhow123/dsh-model-probe#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js"
  },
  "files": ["index.js", "client.js", "locale", "icon.svg", "cordis.patch.yml", "screenshots.json", "assets", "README.md"]
}
